# Copier en `.env` et remplir. Ne JAMAIS commiter `.env`.
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# URL publique ngrok, SANS schéma (ex: a1b2-c3.ngrok-free.app).
# Sert à construire les wss:// du <Stream> et les callbacks Twilio.
PUBLIC_HOSTNAME=

# --- Twilio ----------------------------------------------------------------
# Console > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Les trois numéros ci-dessous sont VOLONTAIREMENT vides. Ne laissez pas un
# simple préfixe ("+1", "+33") : `normalize_number("+33")` vaut "+33", donc une
# valeur tronquée est "non vide" et traverse tous les garde-fous. On part alors
# en requête Twilio avec un numéro invalide (code 21211, opaque), et surtout
# TRUSTED_CONTACT_PHONE_NUMBER=+33 fait rejeter TOUTES les réponses SMS du vrai
# proche. Un champ vide, lui, produit un message clair du type
# « dial_victim ignoré : VICTIM_PHONE_NUMBER vide ». Vide ou complet, jamais entre les deux.

# Numéro US acheté (format E.164). Un numéro FR exige un regulatory bundle.
# Dans le montage "un seul numéro", personne ne le compose jamais : il n'est que
# le relais vers lequel le numéro public ci-dessous est renvoyé.
TWILIO_PHONE_NUMBER=
# LE VRAI NUMÉRO de la personne protégée, celui qu'elle donne à tout le monde et
# qu'elle garde. Elle active UNE FOIS un renvoi d'appel vers TWILIO_PHONE_NUMBER :
#   activer **21*<numéro Twilio>#     annuler ##21#     vérifier *#21#
# On ne l'appelle JAMAIS — l'opérateur renverrait l'appel vers Twilio, qui
# rappellerait ce numéro, qui serait renvoyé… et chaque tour coûte deux jambes
# facturées. C'est la boucle que la garde anti-boucle du webhook entrant refuse.
# COÛT : le renvoi est facturé par l'opérateur de CE numéro (donc à la personne
# protégée, pas à l'appelant) comme un appel vers les États-Unis, souvent hors
# forfait. Vérifier le forfait avant la démo, et faire des appels courts.
PROTECTED_PHONE_NUMBER=
# Repli téléphonique, utilisé seulement si l'app n'est pas ouverte (cf.
# VOICE_CLIENT_IDENTITY). Doit être vérifié si le compte Twilio est en trial.
# Ne JAMAIS y mettre PROTECTED_PHONE_NUMBER : ce serait la boucle de renvoi.
VICTIM_PHONE_NUMBER=
# Numéro du "vrai proche" qui reçoit le SMS de vérification. Doit être le MÊME
# numéro que celui de Lucas Martin dans data/contacts.json, sinon le SMS part à
# quelqu'un dont le dashboard annonce le nom de quelqu'un d'autre.
# À écrire en E.164 strict (+33612345678) : `normalize_number` ne sait pas
# ramener "+33 (0)6 12 34 56 78" à la même forme que ce que Twilio envoie.
TRUSTED_CONTACT_PHONE_NUMBER=
# Nom de la conférence Twilio utilisée pour l'appel.
TWILIO_CONFERENCE_NAME=utopia-guard
# Activer l'Agent Conference dans la console pour le whisper/coach (sinon err 16000).
TWILIO_AGENT_CONFERENCE_ENABLED=false
# Lookup v2 est facturé à la requête : coupe-circuit pour les tests.
# Défaut du code : false. `true` ici est volontaire — c'est le réglage de démo.
# Le laisser à false ne casse rien : le type de ligne dégrade en `unknown`, et
# le signal décisif (identity_mismatch) vient du carnet d'adresses, pas de Lookup.
TWILIO_LOOKUP_ENABLED=true

# Validation de l'en-tête X-Twilio-Signature sur les webhooks /twilio/**.
# ÉTEINT par défaut, et c'est délibéré : derrière ngrok, l'URL que Twilio signe
# et celle que nous recevons diffèrent (réécriture d'hôte, X-Forwarded-Proto),
# donc l'activer sans l'avoir éprouvée transforme chaque webhook en 403 — le
# remède serait plus dangereux que le mal une heure avant une démo.
# À n'activer qu'après avoir vérifié un appel réel de bout en bout.
TWILIO_VALIDATE_SIGNATURE=false

# --- L'app VocalGuard sur le téléphone (SDK Voice JavaScript) --------------
# La jambe « personne protégée » n'est pas un numéro mais une identité client du
# SDK Voice JS : calls.create(to="client:mamie"). C'est ce qui évite la boucle de
# renvoi décrite plus haut, permet d'afficher le VRAI numéro de l'appelant à
# l'écran, et coûte bien moins qu'une minute vers un mobile français.
#
# LIMITE À CONNAÎTRE : une page web ne sonne QUE si elle est ouverte. iOS suspend
# les pages en arrière-plan et il n'y a pas de push VoIP sans application native.
# App fermée -> repli sur VICTIM_PHONE_NUMBER. L'app native (CallKit iOS /
# ConnectionService Android, compte Apple Developer payant) est la roadmap.

# Identité du client Voice. Vide = pas d'app, repli téléphonique (comportement
# d'avant le Lot 1 bis).
VOICE_CLIENT_IDENTITY=
# API Key Twilio (Console > Account > API keys & tokens > Create API key).
# Nécessaire pour SIGNER l'Access Token Voice : le compte-token (TWILIO_AUTH_TOKEN)
# ne sait pas le faire. Le secret ne s'affiche QU'UNE FOIS à la création.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App (AP…), réclamée par le VoiceGrant. Nous ne nous en servons que pour
# les appels ENTRANTS vers l'app, donc sa Voice URL n'a rien à servir.
TWILIO_TWIML_APP_SID=
# Code d'accès à POST /app/token. L'URL ngrok est PUBLIQUE : sans ce PIN,
# n'importe qui obtient un jeton capable de décrocher les appels de la personne
# protégée. Vide = la route refuse tout, plutôt que de distribuer des jetons.
APP_PIN=
# Durée de vie du jeton Voice, en secondes. Court par principe, mais il est
# demandé à l'ouverture de la page et l'app doit encore sonner une heure plus
# tard sans que la personne protégée resaisisse son PIN.
APP_TOKEN_TTL_SECONDS=3600

# --- Routage : liste blanche vs analyse ------------------------------------
# Phrase dite à l'APPELANT inconnu, à lui seul, AVANT tout flux audio. C'est la
# pièce centrale du montage juridique : on n'analyse que ce qui suit
# l'information de l'appelant (ePrivacy art. 5, secret des correspondances).
# Un appelant présent dans data/contacts.json n'entend RIEN et n'est pas analysé.
CALLER_NOTICE_TEXT=Cet appel est analysé par un service de protection contre la fraude.

# --- Vérification d'identité par code --------------------------------------
# Fenêtre pendant laquelle le code à 4 chiffres est valable, en secondes. Deux
# minutes : assez pour que le proche lise son SMS et le dicte, trop court pour
# qu'un arnaqueur tente les 10 000 combinaisons à voix haute.
VERIFY_CODE_TTL_SECONDS=120

# --- Analyse de la voix de la personne protégée seule ----------------------
# Sur un appel de CONFIANCE, n'écouter que SA piste (track="outbound_track"),
# pour l'avertir si c'est ELLE qui s'apprête à donner un code de carte.
# Faux par défaut, et ce n'est pas de la frilosité : la promesse du produit est
# que la famille n'est jamais écoutée. Ne traite que la voix de l'abonnée qui a
# consenti, jamais celle de son interlocuteur — mais reste À VALIDER
# JURIDIQUEMENT avant toute mise en service réelle.
TRUSTED_VICTIM_ONLY_ANALYSIS=false

# --- Démo ------------------------------------------------------------------
# Téléphone qui joue l'arnaqueur. Hors service nominal : ne sert qu'à la démo et
# à scripts/lancer_appel_demo.py.
SCAMMER_PHONE_NUMBER=
# Numéro du carnet que l'appel de démo doit FAIRE SEMBLANT d'afficher.
# Twilio interdit d'usurper un numéro qu'on ne possède pas, et c'est une bonne
# chose : le scénario C (« Lucas » appelle depuis un numéro usurpé) serait donc
# indémontrable. On simule la seule chose qui compte pour la démonstration — ce
# que notre serveur CROIT du From — et uniquement quand l'appel vient de
# SCAMMER_PHONE_NUMBER.
# VIDE PAR DÉFAUT, inerte sans SCAMMER_PHONE_NUMBER, et chaque usage est logué en
# MAJUSCULES : un réglage qui ment sur l'identité de l'appelant ne doit jamais
# pouvoir agir en silence. À vider après la démo.
DEMO_SPOOF_AS=

# --- AWS -------------------------------------------------------------------
AWS_REGION=us-west-2

# N'écrivez PAS vos identifiants AWS ici : ils seraient ignorés en silence.
# `Settings` ne déclare pas ces champs et `extra="ignore"` les jette ; pydantic
# n'exporte rien vers `os.environ` ; et boto3 comme le client de streaming
# Transcribe ne lisent que `os.environ` ou `~/.aws/credentials`. Vérifié : avec
# AWS_ACCESS_KEY_ID posé dans un .env, boto3 résout par `env` et utilise la clé
# du SHELL, pas celle du fichier. Le piège est qu'il « marche » sur la machine
# de quelqu'un qui a déjà des creds exportés, et nulle part ailleurs.
#
# Mettez-les donc dans le shell qui lance `make run`, ou dans ~/.aws/credentials :
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
#   export AWS_SESSION_TOKEN=...        # creds workshop : expirent vite
#
# Contrôle, depuis le MÊME shell que `make run` (doit afficher `env` ou
# `shared-credentials-file`, et jamais lever) :
#   uv run python -c "import boto3;print(boto3.Session().get_credentials().method)"
# Puis `make check-aws`. Les creds du workshop expirent : les rafraîchir impose
# de redémarrer `make run` (le client boto3 est mis en cache par processus).

# --- Amazon Transcribe -----------------------------------------------------
TRANSCRIBE_REGION=us-west-2
TRANSCRIBE_LANGUAGE_CODE=fr-FR
TRANSCRIBE_SAMPLE_RATE=8000
# Repli si le rôle workshop n'autorise pas transcribe:StartStreamTranscription.
# Valeurs : aws | whisper_local | fake  (`fake` = travailler sans AWS ni téléphone)
TRANSCRIBE_BACKEND=aws

# --- Bedrock / Claude ------------------------------------------------------
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=512
# Intervalle minimum entre deux appels Claude, en secondes (anti-latence/coût).
# Mesuré sur Bedrock : 2,85 s de latence médiane. Un seul appel en vol à la fois,
# donc la cadence réelle = max(intervalle, latence) ; en dessous de ~2,8 s c'est
# la latence qui commande. Monter cette valeur ajoute du retard pur sur le score.
LLM_MIN_INTERVAL_SECONDS=2.5
# Nombre de tours de transcript envoyés dans la fenêtre glissante.
LLM_TRANSCRIPT_WINDOW_TURNS=12

# --- Détection de voix synthétique -----------------------------------------
# `make install` n'installe PAS torch : laisser `true` ici fait tenter puis
# échouer le détecteur à chaque appel (proprement, dans un thread, sans bloquer
# la boucle média — mais pour rien). À passer à `true` seulement après
# `make install-voice`. Le signal est de toute façon plafonné : il ne déclenche
# jamais une intervention à lui seul, le modèle généralisant mal sur du 8 kHz.
VOICE_DETECTOR_ENABLED=false
VOICE_DETECTOR_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
VOICE_DETECTOR_WINDOW_SECONDS=4.0
VOICE_DETECTOR_TARGET_SAMPLE_RATE=16000

# --- Scoring (surcharge des poids par défaut) ------------------------------
SCORE_WEIGHT_LLM=45
SCORE_WEIGHT_KEYWORDS=20
SCORE_WEIGHT_VOICE=20
SCORE_WEIGHT_REPUTATION=15

THRESHOLD_WATCH=40
THRESHOLD_ALERT=65
THRESHOLD_INTERVENE=85

# --- Données ---------------------------------------------------------------
CONTACTS_PATH=data/contacts.json
# Aucun audio ni transcript persisté par défaut (argument RGPD du pitch).
PERSIST_TRANSCRIPTS=false
PERSIST_AUDIO=false
